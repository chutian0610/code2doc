{
  "name": "@chutian0610/code2doc",
  "version": "0.2.1",
  "description": "Model-free CLI that lets AI code agents maintain a living, symbol-anchored doc tree for a codebase",
  "license": "MIT",
  "type": "module",
  "bin": {
    "code2doc": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chutian0610/code2doc.git"
  },
  "bugs": {
    "url": "https://github.com/chutian0610/code2doc/issues"
  },
  "homepage": "https://github.com/chutian0610/code2doc#readme",
  "keywords": [
    "documentation",
    "tree-sitter",
    "cli",
    "agent",
    "living-documentation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "tinyglobby": "^0.2.17",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
